<sdf version="1.6">
<world name="drone_inspection_world">
<!--
 ═══════════════════════════════════════════
         PHYSICS & SCENE
    ═══════════════════════════════════════════ 
-->
<physics type="ode">
<real_time_update_rate>1000</real_time_update_rate>
<max_step_size>0.001</max_step_size>
<real_time_factor>1</real_time_factor>
</physics>
<scene>
<ambient>0.6 0.65 0.7 1</ambient>
<background>0.53 0.74 0.95 1</background>
<shadows>true</shadows>
<sky>
<clouds>
<speed>3</speed>
<humidity>0.6</humidity>
<mean_size>0.6</mean_size>
<ambient>0.8 0.85 0.9 1</ambient>
</clouds>
<time>10</time>
<sunrise>6</sunrise>
<sunset>20</sunset>
</sky>
<fog>
<color>0.8 0.85 0.9 1</color>
<type>linear</type>
<start>80</start>
<end>150</end>
<density>0.002</density>
</fog>
</scene>

<!--
 ═══════════════════════════════════════════
         LIGHTING
    ═══════════════════════════════════════════ 
-->
<light name="sun" type="directional">
<cast_shadows>true</cast_shadows>
<pose>0 0 100 0 0.3 0.8</pose>
<diffuse>1.0 0.95 0.85 1</diffuse>
<specular>0.4 0.4 0.3 1</specular>
<direction>-0.5 0.3 -0.8</direction>
<attenuation>
<range>1000</range>
<constant>0.9</constant>
<linear>0.01</linear>
<quadratic>0.001</quadratic>
</attenuation>
</light>

<light name="ambient_fill" type="directional">
<cast_shadows>false</cast_shadows>
<pose>0 0 50 0 0 0</pose>
<diffuse>0.4 0.5 0.6 1</diffuse>
<specular>0.1 0.1 0.1 1</specular>
<direction>0.5 -0.3 -0.6</direction>
</light>

<!--
 ═══════════════════════════════════════════
         GROUND PLANE  (textured grass)
    ═══════════════════════════════════════════ 
-->
<model name="ground_plane">
<static>true</static>
<link name="link">
<collision name="collision">
<geometry>
<plane>
<normal>0 0 1</normal>
<size>200 200</size>
</plane>
</geometry>
<surface>
<friction>
<ode>
<mu>100</mu>
<mu2>50</mu2>
</ode>
</friction>
</surface>
</collision>
<visual name="visual">
<cast_shadows>false</cast_shadows>
<geometry>
<plane>
<normal>0 0 1</normal>
<size>200 200</size>
</plane>
</geometry>
<material>
<script>
<uri>file://media/materials/scripts/gazebo.material</uri>
<name>Gazebo/Grass</name>
</script>
</material>
</visual>
</link>
</model>

<!--
 ═══════════════════════════════════════════
         HOME / LAUNCH PAD  (origin 0,0)
    ═══════════════════════════════════════════ 
-->
<!-- Launch pad base -->
<model name="launch_pad">
<static>true</static>
<pose>0 0 0.02 0 0 0</pose>
<link name="link">
<visual name="pad_visual">
<geometry>
<cylinder>
<radius>1.2</radius>
<length>0.04</length>
</cylinder>
</geometry>
<material>
<ambient>0.15 0.15 0.15 1</ambient>
<diffuse>0.2 0.2 0.2 1</diffuse>
<specular>0.3 0.3 0.3 1</specular>
</material>
</visual>
<collision name="pad_collision">
<geometry>
<cylinder>
<radius>1.2</radius>
<length>0.04</length>
</cylinder>
</geometry>
</collision>
</link>
</model>

<!--
 ═══════════════════════════════════════════
         H MARKING ON PAD  (FIXED)
         bar1 = horizontal crossbar in center
         bar2 = left  vertical leg  (no yaw rotation)
         bar3 = right vertical leg  (no yaw rotation)
    ═══════════════════════════════════════════ 
-->
<!-- Horizontal centre bar of H -->
<model name="pad_h_bar1">
<static>true</static>
<pose>0 0 0.045 0 0 0</pose>
<link name="link">
<visual name="v">
<geometry>
<box>
<!-- wide in X (connects the two legs), thin in Y -->
<size>1.0 0.18 0.01</size>
</box>
</geometry>
<material>
<ambient>1 0.8 0 1</ambient>
<diffuse>1 0.85 0 1</diffuse>
</material>
</visual>
</link>
</model>

<!-- Left vertical leg of H -->
<model name="pad_h_bar2">
<static>true</static>
<!-- shifted -0.5 in X, no rotation -->
<pose>-0.5 0 0.045 0 0 0</pose>
<link name="link">
<visual name="v">
<geometry>
<box>
<!-- thin in X, tall in Y -->
<size>0.18 1.0 0.01</size>
</box>
</geometry>
<material>
<ambient>1 0.8 0 1</ambient>
<diffuse>1 0.85 0 1</diffuse>
</material>
</visual>
</link>
</model>

<!-- Right vertical leg of H -->
<model name="pad_h_bar3">
<static>true</static>
<!-- shifted +0.5 in X, no rotation -->
<pose>0.5 0 0.045 0 0 0</pose>
<link name="link">
<visual name="v">
<geometry>
<box>
<!-- thin in X, tall in Y -->
<size>0.18 1.0 0.01</size>
</box>
</geometry>
<material>
<ambient>1 0.8 0 1</ambient>
<diffuse>1 0.85 0 1</diffuse>
</material>
</visual>
</link>
</model>

